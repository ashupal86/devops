# ============================================================
# TERRAFORM
# ============================================================
#
# State holds the generated RDS password and every resource ID,
# plans can embed secrets, and tfvars are per-machine settings.
# terraform.tfvars.example and .terraform.lock.hcl stay tracked
# (the lock file pins provider versions for everyone).
# ============================================================

.terraform/
.terraform.tfstate.lock.info

*.tfstate
*.tfstate.*

*.tfvars
*.tfvars.json
!*.tfvars.example

*.tfplan
*.tfplan.json
plan.out
*.plan

crash.log
crash.*.log

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc


